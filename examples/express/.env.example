# Copy to .env, or let `npx craftedai init` write the CRAFTEDAI_* values for you.
# Never commit a real .env.

# From `npx craftedai init` (web app only: it mints the widget's sessions)
CRAFTEDAI_SECRET_KEY=
# Signs the user delegation; the web app and the MCP server must share it
CRAFTEDAI_APP_SECRET=
CRAFTEDAI_ORG_ID=

# The agent the widget talks to (the id shown by `npx craftedai init`)
CRAFTEDAI_AGENT_ID=

# Optional. Only behind a proxy or load balancer: the MCP URL exactly as registered in CraftedAI.
# Leave it unset locally; the guard derives the URL from the request.
# CRAFTEDAI_PUBLIC_URL=

# Optional
# PORT=4000
